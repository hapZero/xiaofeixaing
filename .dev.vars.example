# Copy to .dev.vars for local development. Keep real credentials out of Git.
COMFYUI_BASE_URL=http://spark-host:8188
COMFYUI_API_KEY=
COMFYUI_CLIENT_ID=xiaofeixiang-local
COMFYUI_BRIDGE_TOKEN=replace-with-a-random-64-character-token

# Used to encrypt provider credentials before they are stored in D1.
# Generate a long random value and never commit the real value.
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-random-64-character-secret

# Internal FFmpeg service used for dialogue/ambience stems and final renders.
MEDIA_WORKER_URL=http://127.0.0.1:8091
MEDIA_WORKER_TOKEN=xiaofeixiang-local-media-worker
# A media task with no heartbeat beyond this lease is marked interrupted and can be retried.
MEDIA_JOB_LEASE_MS=1800000

# Protects the internal endpoint used by the background episode batch runner.
BATCH_RUNNER_TOKEN=replace-with-a-random-64-character-token
